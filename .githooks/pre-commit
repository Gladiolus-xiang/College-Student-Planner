#!/bin/sh
# 提交前检查：单个文本文件超过 20 KB（约 5000 token）就拒绝提交。
# 图片、Office 文档、lockfile、构建产物不检查。
# 没有白名单：超了就拆，不要再往这里加文件名。

LIMIT=20480

fail=0

for f in $(git diff --cached --name-only --diff-filter=ACM); do
  case "$f" in
    *.png|*.jpg|*.jpeg|*.gif|*.webp|*.svg|*.ico) continue ;;
    *.docx|*.pptx|*.xlsx|*.pdf|*.doc|*.ppt) continue ;;
    *package-lock.json|*.lock|pnpm-lock.yaml|yarn.lock) continue ;;
    dist/*|node_modules/*|*/dist/*) continue ;;
  esac

  [ -f "$f" ] || continue
  size=$(wc -c < "$f" | tr -d ' ')
  case "$size" in
    ''|*[!0-9]*) continue ;;
  esac
  [ "$size" -le "$LIMIT" ] && continue

  kb=$(( (size + 1023) / 1024 ))

  echo "" >&2
  echo "✗ 提交被拒绝：$f 有 ${kb} KB，超过 20 KB 上限" >&2
  echo "  一个文件不该这么大——按功能拆成几个文件，让下次读它的人（包括 AI）读得动。" >&2
  echo "  图片 / Office 文档 / lockfile 不在此限制内。" >&2
  fail=1
done

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "拆完再提交：git add <文件> 后重新 commit。" >&2
fi

exit $fail
